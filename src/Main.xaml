<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PrivacyDesk" Width="1280" Height="960" MinWidth="1040" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0C1220" Foreground="#E8EEF8" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9AAEC8"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#22314A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9AAEC8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tab" Padding="20,12" Background="#111C2F" CornerRadius="7,7,0,0" Margin="0,0,5,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#68E0C4"/><Setter TargetName="tab" Property="Background" Value="#1B2B40"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#18263B"/><Setter Property="Foreground" Value="#9AAEC8"/><Setter Property="Padding" Value="12,12"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#243B55"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="#111C2F"/><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="MinHeight" Value="40"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#243B55"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#111C2F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
 </Window.Resources>
 <Grid Margin="30,22,30,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="125"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Border Background="#EAF9F4" CornerRadius="12" Width="76" Height="76" Margin="0,0,17,0" VerticalAlignment="Center"><Image Name="BrandLogo" Margin="5" Stretch="Uniform"/></Border><StackPanel><TextBlock Text="PRIVACYDESK" FontSize="13" FontWeight="Bold" Foreground="#68E0C4"/><TextBlock Text="Your Windows. Your choices." FontSize="29" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock Name="DeviceLabel" Text="Local audit · No account or cloud connection" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Name="ScanButton" Content="↻  Run audit" Background="#24584F"/><Button Name="UpdatesButton" Content="Check for updates ↗" Padding="12,7" Margin="0,7,9,0" ToolTip="Open github.com/Sl0thzy/privacydesk"/></StackPanel>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,19">
   <Border Background="#142239" CornerRadius="10" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="PRIVACY CONFIGURATION" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Name="PrivacyCount" Text="Ready to scan" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Saved settings, not a guarantee of zero telemetry" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
   <Border Background="#142239" CornerRadius="10" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="SECURITY BASELINE" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Name="SecurityCount" Text="Awaiting audit" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Defender, firewall, boot and encryption checks" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
   <Border Background="#142239" CornerRadius="10" Padding="18,14"><StackPanel><TextBlock Text="RESTORE PROTECTION" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="Snapshot before apply" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Original values + a journal of attempted changes" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="2" Name="Tabs" Background="#111C2F" BorderThickness="0" Padding="15">
   <TabItem Header="Privacy controls"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><TextBlock Name="SelectionLabel" DockPanel.Dock="Right" Text="0 selected" Foreground="#68E0C4" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><Button Name="RecommendedButton" Content="Select low-impact" Padding="12,7"/><Button Name="LocationButton" Content="Add location block" Padding="12,7"/><Button Name="ClearButton" Content="Clear selection" Padding="12,7"/></StackPanel></DockPanel>
    <DataGrid Grid.Row="1" Name="ControlsGrid" IsReadOnly="False">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="Apply" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Available}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
      <DataGridTextColumn Header="Control" Binding="{Binding Title}" Width="*" MinWidth="330" IsReadOnly="True"/>
      <DataGridTextColumn Header="Current state" Binding="{Binding Status}" Width="160" IsReadOnly="True"/>
      <DataGridTextColumn Header="Impact" Binding="{Binding Level}" Width="115" IsReadOnly="True"/>
     </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Background="#1A2A40" CornerRadius="7" Padding="13" Margin="0,10,0,0"><StackPanel><TextBlock Name="DetailTitle" Text="Select a row to review its effects" FontWeight="SemiBold" Foreground="#68E0C4"/><TextBlock Name="DetailText" Text="Nothing is selected automatically. Advanced options can affect device management or compatibility assessment." TextWrapping="Wrap" Foreground="#B9C8DB" Margin="0,5,0,0"/><Expander Header="Show observed values" Foreground="#9AAEC8" Margin="0,6,0,0"><TextBox Name="ObservedText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" Background="#111C2F" Foreground="#B9C8DB" BorderThickness="0" FontFamily="Consolas" FontSize="11"/></Expander></StackPanel></Border>
   </Grid></TabItem>
   <TabItem Header="Security audit"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Read-only results from the latest scan. App changes lists every target with its current value, intended value, and whether it is already done. Not set means Windows controls the default; it does not prove a feature is enabled or disabled." TextWrapping="Wrap" Foreground="#B9C8DB" Margin="0,0,0,12"/>
    <TabControl Grid.Row="1" Name="AuditTabs" Background="#111C2F" BorderThickness="0" Padding="0,10,0,0">
     <TabItem Header="App changes"><DataGrid Name="ChangesAuditGrid" IsReadOnly="True"><DataGrid.Columns>
      <DataGridTextColumn Header="Control" Binding="{Binding Control}" Width="230"/>
      <DataGridTextColumn Header="Setting" Binding="{Binding Target}" Width="230"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Address}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      <DataGridTextColumn Header="Current state" Binding="{Binding Current}" Width="*" MinWidth="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      <DataGridTextColumn Header="App would set" Binding="{Binding Desired}" Width="*" MinWidth="125"/>
      <DataGridTextColumn Header="Already done?" Binding="{Binding Status}" Width="140"/>
     </DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Windows protections"><DataGrid Name="SecurityGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Protection" Binding="{Binding Name}" Width="260"/><DataGridTextColumn Header="Observed status" Binding="{Binding State}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
    </TabControl>
   </Grid></TabItem>
   <TabItem Header="Restore history"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Undo the latest run first. Restore overwrites only that run's attempted targets with their original values. Later manual changes to those same targets will be replaced. A snapshot is not a full Windows backup." TextWrapping="Wrap" Foreground="#B9C8DB" Margin="0,0,0,15"/><DataGrid Grid.Row="1" Name="SnapshotsGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Snapshot" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding Status}" Width="160"/><DataGridTextColumn Header="Targets" Binding="{Binding Count}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,13,0,0"><Button Name="RefreshSnapshotsButton" Content="Refresh history"/><Button Name="RestoreButton" Content="Restore selected snapshot" Background="#6B4537"/><Button Name="OpenFolderButton" Content="Open data folder"/></StackPanel></Grid></TabItem>
   <TabItem Header="About"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Clear choices. Local records. Reversible changes." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock TextWrapping="Wrap" Foreground="#B9C8DB" LineHeight="24" Text="PrivacyDesk 1.1 combines Windows privacy policies with optional service and scheduled-task controls. Everything runs locally using built-in Windows tools. No analytics, accounts, downloads or background agent.&#10;&#10;Pro/Home retain required diagnostic data at their supported minimum. Individual apps, browsers and websites have separate privacy settings. Location restrictions do not hide your IP address. Policies may be overridden by organization management or future Windows updates.&#10;&#10;Snapshots capture selected registry values (including whether they existed), service startup/running state, delayed start, and task enabled state. They do not capture cloud history, entire registry keys, or changes made before the snapshot. Restore leaves empty keys in place. Save any important work and restart when convenient after applying or restoring.&#10;&#10;Advanced controls are deliberately opt-in. A stopped Windows Update service can be normal when idle. This audit does not certify patch compliance or overall system security. The program does not restart your PC automatically.&#10;&#10;This is a locally built, unsigned executable. Source and build instructions are included. Windows may display an unknown-publisher prompt."/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="StatusLabel" Text="Ready. The initial audit starts automatically." Foreground="#B9C8DB" TextWrapping="Wrap"/><ProgressBar Name="Progress" Height="3" Margin="0,8,20,0" Visibility="Collapsed" IsIndeterminate="True" Foreground="#68E0C4" Background="#22314A"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Name="SnapshotButton" Content="Save snapshot only"/><Button Name="ApplyButton" Content="Apply selected changes" Background="#68E0C4" Foreground="#0C1220" FontWeight="SemiBold" Margin="0"/></StackPanel></Grid>
  <Border Grid.Row="4" Background="#080E18" CornerRadius="8" Padding="13,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="LIVE ACTIVITY" Foreground="#68E0C4" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Saved locally · Settings are never changed by an audit" HorizontalAlignment="Right" Foreground="#7187A3" FontSize="11"/></DockPanel><TextBox Name="LogBox" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" Foreground="#A9BCD3" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border>
  <Border Grid.Row="5" Background="#142239" CornerRadius="8" Padding="15,12" Margin="0,12,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Support PrivacyDesk" FontWeight="SemiBold" Foreground="#68E0C4"/><TextBlock Text="Optional donations · Thank you" FontSize="11" Foreground="#9AAEC8" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,15,0"><TextBlock Text="BITCOIN (BTC)" FontSize="10" Foreground="#9AAEC8"/><TextBox Name="BitcoinAddress" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#E8EEF8" FontFamily="Consolas" FontSize="13" Padding="0" Margin="0,4,0,0" ToolTip="Bitcoin donation address"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Name="CopyBitcoinButton" Content="Copy address" Padding="13,9"/><Button Name="LinktreeButton" Content="Visit my Linktree ↗" Padding="13,9" Background="#24584F" Margin="0" ToolTip="https://linktr.ee/mrsquidsloth"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
